# OpenAI project key. Keep this on the server; never expose it to the browser.
OPENAI_API_KEY=

# Password for the private tutor app.
TUTOR_PASSWORD=

# At least 32 random characters for the signed login cookie.
SESSION_SECRET=

# Optional: separate read-only bearer token for GET /api/assistant/context.
# Generate with: openssl rand -hex 32
TUTOR_READ_API_TOKEN=

# Add these later when the learning database is wired in.
DATABASE_URL=
